{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Default",
  "compilerOptions": {
    "forceConsistentCasingInFileNames": true,
    "target": "ES2022",
    "lib": [
      "ESNext"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "noEmit": true,
    "strict": true,
    "baseUrl": "."
  },
  "include": [
    ".",
    "./.apibara/types",
    "./abis",
    "./lib",
    "./indexers"
  ],
  "exclude": [
    "node_modules"
  ]
}